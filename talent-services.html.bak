<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Talent Services — AI &amp; Technology Execution Layer | Qapitol</title>
  <meta name="description" content="Not a staffing firm. Qapitol is the AI &amp; technology execution layer — deploying AI Engineers, MLOps, QE, AIOps, AI Governance specialists across 8 tracks. 2-week placement SLA. Outcome-accountable." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="assets/css/styles.css" />
  <style>
    /* ── Section utilities ── */
    .section-kicker{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--accent-light);margin-bottom:.75rem}
    .section-eyebrow{display:flex;align-items:center;gap:.65rem;margin-bottom:.75rem}
    .eyebrow-line{height:2px;width:28px;background:linear-gradient(90deg,var(--accent),transparent)}
    .section-subtitle{font-size:1.05rem;color:var(--text-muted);line-height:1.75;max-width:660px;margin-top:.75rem}

    /* ── Proof strip ── */
    .proof-strip{display:flex;flex-wrap:wrap;gap:1rem 2.5rem;margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--border)}
    .proof-strip .ps-item{display:flex;align-items:center;gap:.55rem;font-size:.82rem;color:var(--text-muted)}
    .proof-strip .ps-item strong{font-family:"Inter Tight",sans-serif;font-weight:700;color:#fff;font-size:.9rem}
    .ps-dot{width:6px;height:6px;border-radius:50%;background:var(--accent-light);flex-shrink:0}

    /* ── Comparison table ── */
    .compare-wrap{margin-top:2.5rem;border:1px solid var(--border);border-radius:20px;overflow:hidden}
    .compare-head{display:grid;grid-template-columns:1fr 1fr;background:var(--surface-2);border-bottom:1px solid var(--border)}
    .compare-head div{padding:1.25rem 2rem;font-family:"Inter Tight",sans-serif;font-size:.85rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
    .compare-head div:first-child{color:var(--text-muted);border-right:1px solid var(--border)}
    .compare-head div:last-child{color:var(--accent-light)}
    .compare-row{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--border)}
    .compare-row:last-child{border-bottom:none}
    .compare-row div{padding:1.1rem 2rem;font-size:.875rem;line-height:1.6;display:flex;align-items:flex-start;gap:.65rem}
    .compare-row div:first-child{color:var(--text-muted);border-right:1px solid var(--border);background:rgba(255,255,255,.015)}
    .compare-row div:last-child{color:rgba(255,255,255,.9)}
    .compare-icon-bad{color:#f87171;font-style:normal;flex-shrink:0;margin-top:.05rem}
    .compare-icon-good{color:#4ade80;font-style:normal;flex-shrink:0;margin-top:.05rem}
    @media(max-width:600px){.compare-head{grid-template-columns:1fr}.compare-head div:first-child{border-right:none;border-bottom:1px solid var(--border)}.compare-row{grid-template-columns:1fr}.compare-row div:first-child{border-right:none;border-bottom:1px solid var(--border)}}

    /* ── Track cards ── */
    .tracks-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-top:2.5rem}
    @media(max-width:1100px){.tracks-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){.tracks-grid{grid-template-columns:1fr}}
    .track-card{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:1.75rem;transition:border-color .2s,box-shadow .2s,transform .2s;position:relative;overflow:hidden}
    .track-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;opacity:.7}
    .track-card.tc-ai::before{background:linear-gradient(90deg,var(--accent),var(--accent-light))}
    .track-card.tc-qe::before{background:linear-gradient(90deg,var(--teal),#6edfe8)}
    .track-card.tc-mlops::before{background:linear-gradient(90deg,var(--orange),#f5d87a)}
    .track-card.tc-gov::before{background:linear-gradient(90deg,#f87171,#fca5a5)}
    .track-card.tc-auto::before{background:linear-gradient(90deg,#a855f7,#c084fc)}
    .track-card.tc-aiops::before{background:linear-gradient(90deg,#06b6d4,#67e8f9)}
    .track-card.tc-fwd::before{background:linear-gradient(90deg,var(--accent-light),var(--teal))}
    .track-card.tc-pd::before{background:linear-gradient(90deg,var(--orange),var(--accent-light))}
    .track-card:hover{border-color:var(--accent);box-shadow:0 0 0 1px rgba(77,49,245,.3),0 8px 30px rgba(77,49,245,.12);transform:translateY(-3px)}
    .track-icon{font-size:1.8rem;margin-bottom:.85rem}
    .track-card h3{font-family:"Inter Tight",sans-serif;font-size:1rem;font-weight:700;margin-bottom:.35rem}
    .track-desc{font-size:.8rem;color:var(--text-muted);line-height:1.55;margin-bottom:.9rem}
    .track-roles{display:flex;flex-wrap:wrap;gap:.35rem}
    .track-role{font-size:.72rem;font-weight:600;padding:.2rem .6rem;border-radius:99px;background:rgba(255,255,255,.06);border:1px solid var(--border);color:rgba(255,255,255,.7)}

    /* ── Engagement model cards ── */
    .eng-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2.5rem}
    .eng-card{background:var(--surface-2);border:1px solid var(--border);border-radius:20px;padding:2.25rem;position:relative;overflow:hidden;transition:border-color .2s}
    .eng-card::after{content:'';position:absolute;top:0;left:0;right:0;height:4px}
    .eng-card.ec-indigo::after{background:linear-gradient(90deg,var(--accent),var(--accent-light))}
    .eng-card.ec-teal::after{background:linear-gradient(90deg,var(--teal),#6edfe8)}
    .eng-card.ec-orange::after{background:linear-gradient(90deg,var(--orange),#f5b853)}
    .eng-card.ec-purple::after{background:linear-gradient(90deg,#a855f7,#c084fc)}
    .eng-card:hover{border-color:rgba(255,255,255,.2)}
    .eng-badge-pill{display:inline-block;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;padding:.2rem .65rem;border-radius:99px;margin-bottom:1.25rem}
    .ebp-indigo{background:rgba(77,49,245,.18);color:var(--accent-light);border:1px solid rgba(77,49,245,.3)}
    .ebp-teal{background:rgba(33,163,178,.18);color:var(--teal);border:1px solid rgba(33,163,178,.3)}
    .ebp-orange{background:rgba(232,135,33,.18);color:var(--orange);border:1px solid rgba(232,135,33,.3)}
    .ebp-purple{background:rgba(168,85,247,.18);color:#c084fc;border:1px solid rgba(168,85,247,.3)}
    .eng-card h3{font-family:"Inter Tight",sans-serif;font-size:1.2rem;font-weight:800;margin-bottom:.6rem}
    .eng-card p{font-size:.875rem;color:var(--text-muted);line-height:1.7;margin-bottom:1rem}
    .eng-bullets{font-size:.83rem;color:var(--text-muted);list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.4rem;line-height:1.5}
    .eng-bullets li::before{content:"→ ";color:var(--accent-light)}

    /* ── Platform-trained section ── */
    .platform-band{background:linear-gradient(135deg,rgba(77,49,245,.1) 0%,rgba(33,163,178,.07) 100%);border:1px solid rgba(77,49,245,.2);border-radius:24px;padding:3.5rem;margin-top:2.5rem}
    .platform-band h2{font-family:"Inter Tight",sans-serif;font-size:clamp(1.4rem,3vw,2rem);font-weight:800;margin-bottom:.5rem}
    .platform-band .sub{font-size:.95rem;color:var(--text-muted);max-width:580px;margin-bottom:2.5rem;line-height:1.7}
    .platform-points{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem}
    .pp-item{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:12px;padding:1.5rem}
    .pp-item h4{font-family:"Inter Tight",sans-serif;font-size:.95rem;font-weight:700;margin-bottom:.4rem;display:flex;align-items:center;gap:.5rem}
    .pp-item p{font-size:.82rem;color:var(--text-muted);line-height:1.6}

    /* ── Proof bar ── */
    .proof-bar{background:var(--surface-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2.5rem 0;margin:4rem 0}
    .proof-bar .container{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:1.5rem;text-align:center}
    .pb-stat .pb-num{font-size:2.2rem;font-weight:800;font-family:"Inter Tight",sans-serif;background:linear-gradient(135deg,var(--accent-light),var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .pb-stat p{font-size:.78rem;color:var(--text-muted);margin-top:.2rem;line-height:1.4}

    /* ── Testimonials ── */
    .testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-top:2.5rem}
    .testi-card{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:2rem}
    .testi-card blockquote{font-size:.9rem;color:rgba(255,255,255,.85);line-height:1.78;margin:0 0 1.5rem;font-style:normal}
    .testi-card blockquote::before{content:open-quote;font-size:1.6rem;color:var(--accent-light);line-height:0;vertical-align:-.4em;margin-right:.2rem}
    .testi-card blockquote::after{content:close-quote;font-size:1.6rem;color:var(--accent-light);line-height:0;vertical-align:-.4em;margin-left:.2rem}
    .testi-meta{display:flex;align-items:center;gap:.75rem}
    .testi-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.85rem;color:#fff;flex-shrink:0}
    .testi-meta-text strong{display:block;font-size:.88rem;font-weight:700}
    .testi-meta-text span{font-size:.75rem;color:var(--text-muted)}

    /* ── Final CTA ── */
    .ts-cta-band{text-align:center;padding:5rem 0 6rem}
    .ts-cta-band h2{font-family:"Inter Tight",sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;margin-bottom:.75rem}
    .ts-cta-band .cta-sub{font-size:1.05rem;color:var(--text-muted);max-width:560px;margin:0 auto 2rem;line-height:1.7}
    .cta-cluster{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center}

    @media(max-width:640px){.platform-band{padding:2rem}.ts-cta-band{padding:3rem 1rem 4rem}}
  </style>
</head>
