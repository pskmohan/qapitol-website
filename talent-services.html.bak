<!-- ═══════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════ -->
<section class="hero" style="padding-top:7rem;padding-bottom:5rem">
  <div class="container" style="max-width:900px">
    <div class="section-eyebrow">
      <div class="eyebrow-line"></div>
      <span class="section-kicker" style="margin-bottom:0">Talent Services</span>
    </div>
    <h1 style="font-family:'Inter Tight',sans-serif;font-size:clamp(2.4rem,5.5vw,3.8rem);font-weight:800;line-height:1.1;margin-bottom:1.5rem">
      Not a staffing firm.<br/>
      <span class="gradient-text">The AI &amp; technology execution layer.</span>
    </h1>
    <p style="font-size:1.1rem;color:var(--text-muted);max-width:700px;line-height:1.8;margin-bottom:2.5rem">
      We deploy AI Engineers, ML Engineers, Data Scientists, MLOps practitioners, QE specialists, AIOps experts, Domain SMEs, and Forward Deployment teams — pre-trained on Qapitol platforms, aligned to the Q&middot;SURE framework, and accountable to outcomes, not timesheets.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:2.5rem">
      <a href="contact.html" class="btn btn-primary" style="font-size:1rem;padding:.9rem 2rem">Request Talent &rarr;</a>
      <a href="#tracks" class="btn btn-secondary" style="font-size:1rem;padding:.9rem 2rem">View All Tracks</a>
    </div>
    <div class="proof-strip">
      <div class="ps-item"><div class="ps-dot"></div><strong>350+</strong>&nbsp;active practitioners</div>
      <div class="ps-item"><div class="ps-dot"></div><strong>8</strong>&nbsp;talent tracks</div>
      <div class="ps-item"><div class="ps-dot"></div><strong>2-week</strong>&nbsp;placement SLA</div>
      <div class="ps-item"><div class="ps-dot"></div><strong>4 countries</strong></div>
      <div class="ps-item"><div class="ps-dot"></div><strong>25+</strong>&nbsp;unicorns served</div>
      <div class="ps-item"><div class="ps-dot"></div><strong>94%</strong>&nbsp;12-month retention</div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     WHY QAPITOL TALENT — COMPARISON
════════════════════════════════════════════════════════════ -->
<section style="padding:5rem 0">
  <div class="container">
    <div class="section-eyebrow">
      <div class="eyebrow-line"></div>
      <span class="section-kicker" style="margin-bottom:0">Why Qapitol Talent</span>
    </div>
    <h2 style="font-family:'Inter Tight',sans-serif;font-size:clamp(1.7rem,3.5vw,2.4rem);font-weight:800;max-width:640px;margin-bottom:.5rem">The difference between a staffing firm and an execution partner</h2>
    <p class="section-subtitle">Every staffing firm claims quality. Here is what actually separates Qapitol Talent from the market — in plain terms.</p>
    <div class="compare-wrap">
      <div class="compare-head">
        <div>Traditional Staffing</div>
        <div>Qapitol Talent</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> CV matching against a job description — no verified skill assessment</div>
        <div><i class="compare-icon-good">✓</i> Every practitioner is deep-assessed across technical skills, domain fluency, and delivery track record before being offered to clients</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> Generic skills — whatever the candidate already knows</div>
        <div><i class="compare-icon-good">✓</i> Platform-trained on QAVE, CHEQ, Agent Fabric, and Nexus before deployment — productive from day one, not week six</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> Timesheet-based billing — hours logged, not outcomes delivered</div>
        <div><i class="compare-icon-good">✓</i> Outcome accountability from day one — every engagement has defined, measurable delivery milestones</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> Typically QE or development only — one or two disciplines</div>
        <div><i class="compare-icon-good">✓</i> 8 full-spectrum tracks: AI/ML Engineering, QE, MLOps, AI Governance, Intelligent Automation, AIOps, Forward Deployment, Product &amp; Domain</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> No shared methodology — every engagement reinvents the wheel</div>
        <div><i class="compare-icon-good">✓</i> Q&middot;SURE certified — every practitioner operates within a shared AI governance, evaluation, and reliability framework</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> India-only delivery, single timezone, no global coverage</div>
        <div><i class="compare-icon-good">✓</i> 4 countries: India, US, UK, Singapore — follow-the-sun delivery and onsite placement available globally</div>
      </div>
      <div class="compare-row">
        <div><i class="compare-icon-bad">✗</i> No ramp support — you onboard them, you absorb the productivity gap</div>
        <div><i class="compare-icon-good">✓</i> 2-week productive deployment SLA — Qapitol owns the ramp, handles the onboarding, and tracks practitioner performance from week one</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     EIGHT TALENT TRACKS
════════════════════════════════════════════════════════════ -->
<section id="tracks" style="padding:5rem 0;background:linear-gradient(180deg,transparent,rgba(77,49,245,.05) 50%,transparent)">
  <div class="container">
    <div class="section-eyebrow">
      <div class="eyebrow-line"></div>
      <span class="section-kicker" style="margin-bottom:0">Eight Talent Tracks</span>
    </div>
